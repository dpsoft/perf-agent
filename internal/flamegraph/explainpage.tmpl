<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.Title}}</title>
<style>
{{.CSS}}</style>
<style>{{.Palette}}</style>
</head>
<body>
<header class="top">
<span class="brand"><b>perf-agent</b><i>Enjoy the Flames.</i></span>
<h1>{{template "segs" .TitleSegs}}</h1>
<span class="readout">View <b>{{.View}}</b></span>
<div class="prov">
<span class="pill ai">✦ Explained by an agent via MCP</span>
<span class="pill ok" title="Each structured claim was compared with the engine at its rounding, and each frame reference resolved">{{.CheckedPill}}</span>
<span class="pill">prose is not verified</span>
{{with .RejectedPill}}<span class="pill bad">{{.}}</span>
{{end}}{{with .LimitPill}}<span class="pill bad">{{.}}</span>
{{end}}{{with .HistoryPill}}<span class="pill bad">{{.}}</span>
{{end}}</div>
</header>
<div class="legend" aria-label="Colour key">{{range .Legend}}<span class="c"><i class="sw" data-domain="{{.Key}}"></i>{{.Label}}</span>{{end}}<span class="c key">✦ path with an explanation</span></div>
{{if .Notes}}<section class="notes" aria-label="Sampling notes"><b>Sampling notes</b>
<ul>{{range .Notes}}<li>{{.}}</li>{{end}}</ul>
</section>
{{end}}<main class="body">
<div class="graph">
<div class="canvas"><div class="chart" id="chart" style="height:{{.Height}}px">
{{range .Frames}}<div class="frame{{.Class}}" style="left:{{.Left}}%;width:{{.Width}}%;top:{{.Top}}px" data-i="{{.I}}" data-domain="{{.Domain}}"{{with .Resolution}} data-resolution="{{.}}"{{end}} tabindex="0" role="button" title="{{.Tip}}"><span class="fl">{{if .Star}}<span class="star">✦</span>{{end}}{{.Name}}</span></div>
{{end}}</div>
</div>
<div class="axis"><span>{{.View}} · {{.Axis}}</span><span title="{{.TotalTitle}}">total {{.Total}}</span></div>
{{with .NarrowNote}}<p class="left-out">{{.}}</p>
{{end}}{{with .LimitNote}}<p class="left-out">{{.}}</p>
{{end}}{{with .SizeNote}}<p class="left-out">{{.}}</p>
{{end}}<section aria-label="Paths the agent explained"><h4>Paths the agent explained</h4>
{{range .Rows}}<button type="button" class="exrow" data-node="{{.Node}}"><span class="star">✦</span><span class="ref">{{.Ref}}</span><code>{{.Name}}</code><span class="w">{{.Share}} · {{.Cum}}</span></button>
{{else}}<p class="muted">The agent explained no path.</p>
{{end}}</section>
<section aria-label="Quality summary"><h4>Quality summary</h4>
<div class="qgrid">{{range .Quality}}<span class="k">{{.Label}}</span><span class="v" title="{{.Title}}">{{.Value}}</span><span class="st st-{{.Status}}">{{.Status}}</span><span class="p">{{.Note}}</span>{{end}}</div>
</section>
</div>
<aside class="side" aria-label="Selected frame">
<div class="hd"><div class="lbl">Frame details · <span class="ref" id="sel-ref">{{.Sel.Ref}}</span></div><div class="nm" id="sel-name">{{.Sel.Name}}</div><div class="nid" id="sel-id">{{.Sel.ID}}</div></div>
<section class="sec"><h5>Profile facts — computed by perf-agent</h5>
<div class="facts" id="facts">{{range .SelFacts}}<span class="k">{{.Label}}</span><span class="v" title="{{.Title}}">{{.Value}}</span><span class="p">{{.Note}}</span>{{end}}</div>
</section>
<div id="exp">{{range .Sel.Explanation}}{{template "exp" .}}{{end}}</div>
<p class="sec muted" id="noexp"{{if .Sel.Explanation}} hidden{{end}}>The agent did not explain this frame: these are the profile's facts only.</p>
{{if or .Rejected .RejectedNote}}<section class="sec"><h5>Rejected at render</h5>
<p class="muted">perf-agent refused these in earlier attempts. A claim row strikes through the agent's figure beside the engine's; reference and limit rows say what was wrong. This page is the attempt that passed.</p>
{{with .RejectedNote}}<p class="muted">{{.}}</p>
{{end}}<ul class="rej">{{range .Rejected}}<li><span class="ref">{{.Attempt}}</span> {{with .Evidence}}<span class="muted">({{.}})</span> {{end}}{{.Label}}{{if eq .Kind "claim"}}{{if .Metric}} (<code>{{.Metric}}</code> of {{.Node}}){{end}}:{{if .Agent}} the agent wrote <s>{{.Agent}}</s>{{end}}{{if .Engine}}{{if .Agent}},{{end}} perf-agent has <b>{{.Engine}}</b>{{end}}<div class="why">{{.Code}}: {{.Reason}}</div>{{else if eq .Kind "more"}}{{else}}: {{.Reason}}{{end}}</li>
{{end}}</ul>
</section>
{{end}}<section class="sec"><h5>Path (root → frame)</h5>
<ol class="path" id="path">{{range .SelPath}}<li><button type="button" data-node="{{.Node}}"><span class="ref">{{.Ref}}</span><span class="pn">{{.Name}}</span><span class="c">{{.Share}}</span></button></li>{{end}}</ol>
</section>
<section class="sec"><h5>Follow up in your agent</h5>
<p class="muted">Copies a question to paste into your MCP client, with the profile and the frame already named.</p>
<div class="chips" id="chips">{{range .Chips}}<button type="button" class="chip" data-prompt="{{.Prompt}}">{{.Label}}</button>{{end}}</div>
<textarea id="copybox" rows="3" readonly hidden aria-label="Prompt to copy"></textarea>
</section>
</aside>
</main>
<footer class="foot"><span title="{{.TotalTitle}}">Total {{.Total}}</span><span>View {{.View}}</span>{{with .ProfileName}}<span>Profile {{.}}</span>{{end}}{{with .Digest}}<span>Digest <code>{{.}}</code></span>{{end}}{{with .Attempt}}<span>Attempt {{.}}</span>{{end}}</footer>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script type="application/json" id="model">{{.Model}}</script>
<script>{{.Script}}</script>
</body>
</html>
{{define "segs"}}{{range .}}{{if eq .Kind "claim"}}<span class="claim" title="{{.Title}}">{{.Text}}</span>{{else if eq .Kind "node"}}<button type="button" class="cite" data-node="{{.Node}}" title="{{.Title}}">{{.Text}}</button> <code>{{.Name}}</code>{{else if eq .Kind "unchecked"}}<mark class="unchecked" title="{{.Title}}">{{.Text}}</mark>{{else}}{{.Text}}{{end}}{{end}}{{end}}
{{define "exp"}}<section class="sec interp"><h5>Agent interpretation — prose, not verified</h5><p>{{template "segs" .Prose}}</p></section>
{{if .Hypotheses}}<section class="sec"><h5>Hypotheses — the agent's, not measured</h5><ul class="hyp">{{range .Hypotheses}}<li><b>Hypothesis:</b> {{template "segs" .}}</li>{{end}}</ul></section>
{{end}}{{if .Next}}<section class="sec"><h5>Next measurement — the agent's suggestion, not verified</h5><p>{{template "segs" .Next}}</p></section>
{{end}}{{end}}
