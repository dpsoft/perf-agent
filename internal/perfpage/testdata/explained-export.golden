<script type="application/json" id="model">{"view":"cpu/nanoseconds#0","selected":"19f8d19ed72f72ff","fact_rows":[{"k":"Cumulative","u":"nanoseconds","r":"exact"},{"k":"Self","u":"nanoseconds","r":"exact"},{"k":"Share of total","n":"of the view total","u":"ratio","d":"view_total","r":"0.001 ratio"},{"k":"Share of parent","pn":true,"u":"ratio","d":"parent","r":"0.001 ratio"},{"k":"Inexact portion","n":"from inexact samples","u":"nanoseconds","r":"exact"}],"frames":[{"id":"e3b0c44298fc1c14","ref":"f0","name":"all","cum":"1000","share":"100.0%","facts":[{"v":"1.00 µs","c":"1000"},{"v":"0","c":"0","z":true},{"v":"100.0%","c":"1.000"},{"v":"unavailable: no parent"},{"v":"0","c":"0","z":true}]},{"id":"6d8817fb4e98e681","ref":"f1","name":"main","parent":"e3b0c44298fc1c14","cum":"1000","share":"100.0%","facts":[{"v":"1.00 µs","c":"1000"},{"v":"0","c":"0","z":true},{"v":"100.0%","c":"1.000"},{"v":"100.0%","c":"1.000"},{"v":"0","c":"0","z":true}]},{"id":"50666367c7698688","ref":"f2","name":"a","parent":"6d8817fb4e98e681","cum":"511","share":"51.1%","facts":[{"v":"511 ns","c":"511"},{"v":"100 ns","c":"100"},{"v":"51.1%","c":"0.511"},{"v":"51.1%","c":"0.511"},{"v":"0","c":"0","z":true}]},{"id":"dc7211ebcac6e9c7","ref":"f3","name":"c","parent":"6d8817fb4e98e681","cum":"489","share":"48.9%","facts":[{"v":"489 ns","c":"489"},{"v":"489 ns","c":"489"},{"v":"48.9%","c":"0.489"},{"v":"48.9%","c":"0.489"},{"v":"0","c":"0","z":true}]},{"id":"19f8d19ed72f72ff","ref":"f4","name":"b","parent":"50666367c7698688","cum":"411","share":"41.1%","facts":[{"v":"411 ns","c":"411"},{"v":"411 ns","c":"411"},{"v":"41.1%","c":"0.411"},{"v":"80.4%","c":"0.804"},{"v":"0","c":"0","z":true}],"extra":[{"k":"Executions below","v":"unavailable: no sidecar","t":"unavailable: no sidecar","n":"the executions log is not usable"},{"k":"Kernel names observed","v":"unavailable: not a GPU view","t":"unavailable: not a GPU view","n":"names at or below, not distinct kernels"}],"explanation":[{"prose":[{"kind":"text","text":"b takes "},{"kind":"claim","text":"41.1%","title":"share_of_total of b (node 19f8d19ed72f72ff): 0.411 ratio of view_total, rounded to 0.001 ratio; checked by perf-agent"}],"hypotheses":null,"next":[]}]}],"prompts":[{"label":"Why is it wide?","parts":[{"s":"Why is node "},{"slot":"id"},{"s":" ("},{"slot":"name"},{"s":") wide? Use perf-agent-mcp: open the profile cpu.pb.gz (relative to the profiles root), check that its profile_digest is 891132b92a6ac5299fbf52b1cb95fc7f8a4f8c07d04354077e4471c128e9b17b, view cpu/nanoseconds#0."}]},{"label":"Is it profiler overhead?","parts":[{"s":"Is any of node "},{"slot":"id"},{"s":" profiler overhead? Use perf-agent-mcp: open the profile cpu.pb.gz (relative to the profiles root), check that its profile_digest is 891132b92a6ac5299fbf52b1cb95fc7f8a4f8c07d04354077e4471c128e9b17b, view cpu/nanoseconds#0."}]},{"label":"Compare with another profile","parts":[{"s":"Compare node "},{"slot":"id"},{"s":" with another profile using diff. Use perf-agent-mcp: open the profile cpu.pb.gz (relative to the profiles root), check that its profile_digest is 891132b92a6ac5299fbf52b1cb95fc7f8a4f8c07d04354077e4471c128e9b17b, view cpu/nanoseconds#0."}]}]}</script>
<script>// perfAgentPanel builds the explained page's side panel. model is the
// page's model (fact_rows, prompts); hooks is {frameById(id), elementFor(id),
// onSelect(id)}: frameById returns a frame object or undefined, elementFor
// the drawn element of a frame or null, and onSelect is called with the id of
// a frame the viewer picked inside the panel. It returns {show(frame, path),
// factRows(f), explanation(parent, e), segments(parent, segs)}; path is the
// list of path items from the root's child down to the frame, each with at
// least id, ref, name and share.
function perfAgentPanel(model, hooks) {
  'use strict';
  const $ = (id) => document.getElementById(id);
  const chart = $('chart');

  const make = (tag, cls, text) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };
  const clear = (e) => {
    while (e.firstChild) e.removeChild(e.firstChild);
  };

  const segments = (parent, segs) => {
    for (const s of segs || []) {
      if (s.kind === 'claim') {
        const e = make('span', 'claim', s.text);
        e.title = s.title;
        parent.appendChild(e);
      } else if (s.kind === 'node') {
        const b = make('button', 'cite', s.text);
        b.type = 'button';
        b.dataset.node = s.node;
        b.title = s.title;
        parent.appendChild(b);
        parent.appendChild(document.createTextNode(' '));
        parent.appendChild(make('code', '', s.name));
      } else if (s.kind === 'unchecked') {
        const m = make('mark', 'unchecked', s.text);
        m.title = s.title;
        parent.appendChild(m);
      } else {
        parent.appendChild(document.createTextNode(s.text));
      }
    }
  };

  const section = (cls, heading) => {
    const s = make('section', cls ? 'sec ' + cls : 'sec');
    s.appendChild(make('h5', '', heading));
    return s;
  };

  const explanation = (parent, e) => {
    const interp = section('interp', 'Agent interpretation — prose, not verified');
    const p = make('p');
    segments(p, e.prose);
    interp.appendChild(p);
    parent.appendChild(interp);
    if (e.hypotheses && e.hypotheses.length) {
      const hs = section('', "Hypotheses — the agent's, not measured");
      const ul = make('ul', 'hyp');
      for (const h of e.hypotheses) {
        const li = make('li');
        li.appendChild(make('b', '', 'Hypothesis:'));
        li.appendChild(document.createTextNode(' '));
        segments(li, h);
        ul.appendChild(li);
      }
      hs.appendChild(ul);
      parent.appendChild(hs);
    }
    if (e.next && e.next.length) {
      const ns = section('', "Next measurement — the agent's suggestion, not verified");
      const p2 = make('p');
      segments(p2, e.next);
      ns.appendChild(p2);
      parent.appendChild(ns);
    }
  };

  const maxPromptName = 200;
  const promptName = (name) => {
    const chars = Array.from(name);
    return chars.length > maxPromptName ? chars.slice(0, maxPromptName).join('') + '…' : name;
  };
  const prompt = (p, f) => p.parts.map((part) => {
    if (part.slot === 'id') return f.id;
    if (part.slot === 'name') return promptName(f.name);
    return part.s || '';
  }).join('');

  const exactTitle = (c, unit, den, rounding, zero) => {
    let s = c + ' ' + unit;
    if (den) s += ' of ' + den;
    if (rounding === 'exact') s += ', exact';
    else if (rounding) s += ', rounded to ' + rounding;
    if (zero) s += ', measured zero';
    return s;
  };
  const factRowsWith = (f, parent) => {
    const rows = model.fact_rows.map((spec, i) => {
      const val = f.facts[i];
      let note = spec.n || '';
      if (spec.pn) note = parent ? 'of ' + parent.name : '';
      let title = val.v;
      if (val.c) title = exactTitle(val.c, spec.u, spec.d === 'parent' ? 'parent:' + f.parent : spec.d, spec.r, val.z);
      return {k: spec.k, v: val.v, t: title, n: note};
    });
    return rows.concat(f.extra || []);
  };
  const factRows = (f) => factRowsWith(f, f.parent ? hooks.frameById(f.parent) : undefined);

  let currentEl = null;
  const show = (f, path) => {
    if (!f) return;
    if (currentEl) currentEl.classList.remove('cur');
    currentEl = hooks.elementFor(f.id) || null;
    if (currentEl) currentEl.classList.add('cur');
    $('sel-ref').textContent = f.ref;
    $('sel-name').textContent = f.name;
    $('sel-id').textContent = f.id;

    const parent = (f.parent && (hooks.frameById(f.parent) || (path || []).find((g) => g.id === f.parent))) || undefined;
    const facts = $('facts');
    clear(facts);
    for (const r of factRowsWith(f, parent)) {
      facts.appendChild(make('span', 'k', r.k));
      const v = make('span', 'v', r.v);
      v.title = r.t;
      facts.appendChild(v);
      facts.appendChild(make('span', 'p', r.n || ''));
    }

    const exp = $('exp');
    clear(exp);
    const list = f.explanation || [];
    for (const e of list) explanation(exp, e);
    $('noexp').hidden = list.length > 0;

    if (chart) for (const c of chart.querySelectorAll('.frame.cite')) c.classList.remove('cite');
    for (const b of exp.querySelectorAll('button.cite')) {
      const ce = hooks.elementFor(b.dataset.node);
      if (ce && b.dataset.node !== f.id) ce.classList.add('cite');
    }

    const pathEl = $('path');
    clear(pathEl);
    for (const g of path || []) {
      const li = make('li');
      const b = make('button');
      b.type = 'button';
      b.dataset.node = g.id;
      b.appendChild(make('span', 'ref', g.ref));
      b.appendChild(make('span', 'pn', g.name));
      b.appendChild(make('span', 'c', g.share));
      li.appendChild(b);
      pathEl.appendChild(li);
    }

    const chips = $('chips');
    clear(chips);
    for (const p of model.prompts) {
      const b = make('button', 'chip', p.label);
      b.type = 'button';
      b.dataset.prompt = prompt(p, f);
      chips.appendChild(b);
    }
    $('copybox').hidden = true;
  };

  // Frames picked inside the panel (a reference in the explanation or a
  // path entry) go to onSelect. The click stops here: show() replaces the
  // panel's content, so a handler further up would find the target detached
  // from the panel and take it for a click elsewhere.
  const picked = (ev) => {
    const b = ev.target.closest('[data-node]');
    if (!b) return;
    ev.stopPropagation();
    hooks.onSelect(b.dataset.node);
  };
  $('exp').addEventListener('click', picked);
  $('path').addEventListener('click', picked);

  return {show, factRows, explanation, segments};
}

(() => {
  'use strict';
  const $ = (id) => document.getElementById(id);
  const model = JSON.parse($('model').textContent);
  const frames = model.frames;
  const byId = new Map();
  frames.forEach((f, i) => byId.set(f.id, i));
  const chart = $('chart');
  const els = new Map();
  for (const el of chart.querySelectorAll('.frame')) els.set(Number(el.dataset.i), el);

  const chainFromModel = (i) => {
    const chain = [];
    for (let g = frames[i]; g && g.parent; g = frames[byId.get(g.parent)]) chain.push(g);
    return chain.reverse();
  };

  let panel;
  const select = (i, scroll) => {
    const f = frames[i];
    if (!f) return;
    panel.show(f, chainFromModel(i));
    const el = els.get(i);
    if (el && scroll) el.scrollIntoView({block: 'nearest', inline: 'nearest'});
  };
  panel = perfAgentPanel(model, {
    frameById: (id) => frames[byId.get(id)],
    elementFor: (id) => els.get(byId.get(id)),
    onSelect: (id) => {
      if (byId.has(id)) select(byId.get(id), true);
    },
  });

  let toastTimer = 0;
  const toast = (msg) => {
    const t = $('toast');
    t.textContent = msg;
    t.classList.add('on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('on'), 2200);
  };
  const fallback = (text) => {
    const box = $('copybox');
    box.value = text;
    box.hidden = false;
    box.focus();
    box.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch (e) {
      ok = false;
    }
    toast(ok ? 'Copied the prompt' : 'Press Ctrl+C to copy the selected prompt');
  };
  const copy = (text) => {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(() => toast('Copied the prompt'), () => fallback(text));
    } else {
      fallback(text);
    }
  };

  chart.addEventListener('click', (ev) => {
    const el = ev.target.closest('.frame');
    if (el) select(Number(el.dataset.i), false);
  });
  chart.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Enter' && ev.key !== ' ') return;
    const el = ev.target.closest('.frame');
    if (!el) return;
    ev.preventDefault();
    select(Number(el.dataset.i), false);
  });
  document.addEventListener('click', (ev) => {
    const chip = ev.target.closest('[data-prompt]');
    if (chip) {
      copy(chip.dataset.prompt);
      return;
    }
    const ref = ev.target.closest('[data-node]');
    if (ref && !ref.closest('#exp, #path') && byId.has(ref.dataset.node)) select(byId.get(ref.dataset.node), true);
  });

  if (byId.has(model.selected)) select(byId.get(model.selected), false);
})();
</script>
</body>
</html>


